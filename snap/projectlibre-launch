#!/bin/sh

export FONTCONFIG_FILE="$SNAP/projectlibre/etc/fonts/fonts.conf"
export FONTCONFIG_PATH="$SNAP/projectlibre/etc/fonts"

# Snap refreshes copy OpenJDK's generated logical-font map into the new
# revision's user data. Invalidate that cache once per revision so it is
# regenerated from this snap's fontconfig configuration.
font_cache_marker="$SNAP_USER_DATA/.java/fontconfig-snap-revision"
if [ "$(cat "$font_cache_marker" 2>/dev/null || true)" != "$SNAP_REVISION" ]; then
    for font_cache_dir in "$SNAP_USER_DATA"/.java/fonts/*; do
        [ -d "$font_cache_dir" ] || continue
        rm -f "$font_cache_dir"/fcinfo-*.properties
    done
    mkdir -p "$(dirname "$font_cache_marker")"
    printf '%s\n' "$SNAP_REVISION" > "$font_cache_marker"
fi

# ProjectLibre persists JAVA_EXE as an absolute path in run.conf. Snap data is
# copied between revisions, but that path belongs to the previous revision.
run_conf="$HOME/.projectlibre/run.conf"
if [ -f "$run_conf" ]; then
    run_conf_tmp="$run_conf.tmp"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            JAVA_EXE=*) printf 'JAVA_EXE="%s"\n' "$SNAP/usr/lib/jvm/default-java/bin/java" ;;
            *) printf '%s\n' "$line" ;;
        esac
    done < "$run_conf" > "$run_conf_tmp"
    mv "$run_conf_tmp" "$run_conf"
fi

exec "$SNAP/projectlibre/projectlibre.sh" "$@"
